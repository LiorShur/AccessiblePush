rules_version = '2';

// ---------------------------------------------------------------
// Access Nature — Firestore security rules
//
// IMPORTANT: This file must match what's actually deployed. Deploy
// with: firebase deploy --only firestore:rules
//
// The rules keep two collections open to any signed-in user (routes
// and trail_guides) because the pilot targets a small, trusted group.
// Tighten before public launch: block owner-updates of isPublic and
// reviewStatus so surveyors can't self-publish.
// ---------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPERS ====================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function isCreator() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ==================== ROUTES ====================
    // Owners read/update/delete their own; admins full access. Any
    // signed-in user can create (route ownership set at write time).

    match /routes/{routeId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isCreator();
      allow update: if isOwner() || isAdmin();
      allow delete: if isOwner() || isAdmin();
    }

    // ==================== TRAIL GUIDES ====================
    // Public guides readable by anyone; owner + admin full access.

    match /trail_guides/{guideId} {
      allow read: if resource.data.isPublic == true || isOwner() || isAdmin();
      allow create: if isCreator();
      allow update: if isOwner() || isAdmin();
      allow delete: if isOwner() || isAdmin();
    }

    // ==================== TRAIL CONDITIONS ====================

    match /trail_conditions/{conditionId} {
      allow read: if true;
      allow create: if isCreator();
      allow update: if isOwner() || isAdmin();
      allow delete: if isOwner() || isAdmin();

      // Any signed-in user can update engagement status fields
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['fixedReports', 'fixedReportsCount',
                                  'notFoundReports', 'notFoundReportsCount',
                                  'lastStatusUpdate', 'expiresAt',
                                  'autoExpiredReason']);
    }

    // ==================== ACCESSIBILITY REPORTS ====================

    match /accessibilityReports/{reportId} {
      allow read: if resource.data.isPublic == true || isOwner() || isAdmin();
      allow list: if isSignedIn() || isAdmin();
      allow create: if isCreator();
      allow update: if isOwner() || isAdmin();
      allow delete: if isOwner() || isAdmin();

      // Any signed-in user can update engagement fields
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['upvotes', 'upvotedBy', 'verificationCount',
                                  'verifiedBy', 'lastVerifiedAt']);

      match /comments/{commentId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ==================== USERS ====================

    match /users/{userId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    // ==================== NOTIFICATIONS ====================

    match /reportNotifications/{notificationId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid || isAdmin();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid || isAdmin();
    }

    // ==================== STATS ====================

    match /reportStats/{statId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ==================== AUTHORITIES ====================

    match /authorities/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ==================== BETA FEEDBACK ====================
    // Anyone can submit (even anonymous surveyors mid-session); only
    // admins can read. Used by the surveyor "Report a problem" button
    // and any general in-app feedback.

    match /beta_feedback/{feedbackId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==================== PUSH NOTIFICATIONS ====================

    match /app_config/{configId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /push_subscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    match /notifications_queue/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Cloud Functions only
    }

    match /notifications_sent/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false; // Cloud Functions only
    }

    // ==================== ANNOUNCEMENTS ====================

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==================== SURVEYOR PROGRAMME ====================

    // Admin roster — a user can read their own admin doc (needed by the
    // client-side coordinator check). Admins can grant admin to others.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Surveyor whitelist. Doc id = lowercased email. A signed-in user
    // can read their own doc for the whitelist check; admins manage.
    match /surveyors/{email} {
      allow read: if isSignedIn()
                  && request.auth.token.email.lower() == email;
      allow list, write: if isAdmin();
    }

    // Trail assignments — any signed-in user reads (surveyor sees their
    // list); admins write.
    match /trail_assignments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
